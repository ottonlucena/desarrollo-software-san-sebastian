<div class="container mt-4">
  <a href="/affiliates" class="btn btn-outline-secondary btn-sm mb-3">← Volver al listado</a>

  <h1 class="mb-3">{{affiliate.firstName}} {{affiliate.lastName}}</h1>

  <div class="card mb-4">
    <div class="card-body">
      <p class="card-text"><strong>ID:</strong> {{affiliate.id}}</p>
      <p class="card-text"><strong>Email:</strong> {{affiliate.email}}</p>
      <p class="card-text"><strong>Tipo de afiliación:</strong> <span class="text-capitalize">{{affiliate.membershipType}}</span></p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h4 mb-3">Simulador de descuento</h2>
      <form action="/affiliates/{{affiliate.id}}/simulate" method="POST" class="row g-3">
        <div class="col-md-6">
          <label for="treatmentAmount" class="form-label">Monto del tratamiento:</label>
          <input type="number" id="treatmentAmount" name="treatmentAmount" class="form-control" min="1" step="1" required>
        </div>
        <div class="col-md-6 d-flex align-items-end">
          <button type="submit" class="btn btn-success">Calcular precio final</button>
        </div>
      </form>

      {{#if error}}
        <div class="alert alert-danger mt-3">{{error}}</div>
      {{/if}}

      {{#if simulation}}
        <div class="alert alert-info mt-3 mb-0">
          <p class="mb-1"><strong>Monto original:</strong> ${{simulation.treatmentAmount}}</p>
          <p class="mb-1"><strong>Descuento aplicado:</strong> {{simulation.discountPercent}}%</p>
          <p class="mb-1"><strong>Monto descontado:</strong> ${{simulation.discountAmount}}</p>
          <p class="mb-0"><strong>Precio final:</strong> ${{simulation.finalPrice}}</p>
        </div>
      {{/if}}
    </div>
  </div>

  <div class="d-flex gap-2">
    <a href="/affiliates/{{affiliate.id}}/edit" class="btn btn-warning">Editar</a>
    <form action="/affiliates/{{affiliate.id}}/delete" method="POST">
      <button type="submit" class="btn btn-danger">Eliminar</button>
    </form>
  </div>
</div>
