{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "types": ["node", "express-session"],
    "skipLibCheck": true
  },
  "ts-node": {
    "files": true
  },
  "include": ["src/**/*", "src/types/**/*.d.ts"],
  "exclude": ["tsdown.config.ts", "prisma/seed.ts", "node_modules", "dist"]
}
