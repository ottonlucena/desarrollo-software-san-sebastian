<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Afiliados DentPlus</h1>
    <a href="/affiliates/create" class="btn btn-primary">+ Nuevo afiliado</a>
  </div>

  {{#if affiliates}}
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Email</th>
          <th>Afiliación</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {{#each affiliates}}
          <tr>
            <td>{{id}}</td>
            <td>{{firstName}} {{lastName}}</td>
            <td>{{email}}</td>
            <td class="text-capitalize">{{membershipType}}</td>
            <td>
              <a href="/affiliates/{{id}}" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p class="text-muted">No hay afiliados registrados todavía.</p>
  {{/if}}
</div>
