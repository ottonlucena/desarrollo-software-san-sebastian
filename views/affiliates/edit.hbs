<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h3 mb-3">Editar afiliado</h1>

        <p class="text-muted">
          Actualiza los datos del paciente afiliado.
        </p>

        {{#if error}}
          <div class="alert alert-danger">
            {{error}}
          </div>
        {{/if}}

        <form action="/affiliates/{{affiliate.id}}/edit" method="POST" novalidate>
          <div class="mb-3">
            <label for="firstName" class="form-label">Nombre</label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              class="form-control {{#if errors.firstName}}is-invalid{{/if}}"
              value="{{#if values.firstName}}{{values.firstName}}{{else}}{{affiliate.firstName}}{{/if}}"
            >

            {{#if errors.firstName}}
              <div class="invalid-feedback">
                {{errors.firstName}}
              </div>
            {{/if}}
          </div>

          <div class="mb-3">
            <label for="lastName" class="form-label">Apellido</label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              class="form-control {{#if errors.lastName}}is-invalid{{/if}}"
              value="{{#if values.lastName}}{{values.lastName}}{{else}}{{affiliate.lastName}}{{/if}}"
            >

            {{#if errors.lastName}}
              <div class="invalid-feedback">
                {{errors.lastName}}
              </div>
            {{/if}}
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control {{#if errors.email}}is-invalid{{/if}}"
              value="{{#if values.email}}{{values.email}}{{else}}{{affiliate.email}}{{/if}}"
            >

            {{#if errors.email}}
              <div class="invalid-feedback">
                {{errors.email}}
              </div>
            {{/if}}
          </div>

          <div class="mb-4">
            <label for="membershipType" class="form-label">Tipo de afiliación</label>
            <select
              id="membershipType"
              name="membershipType"
              class="form-select {{#if errors.membershipType}}is-invalid{{/if}}"
            >
              {{#each membershipOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>
                  {{label}}
                </option>
              {{/each}}
            </select>

            {{#if errors.membershipType}}
              <div class="invalid-feedback">
                {{errors.membershipType}}
              </div>
            {{/if}}

            <small class="text-muted">
              Afiliación actual: {{affiliate.membershipType}}
            </small>
          </div>

          <div class="d-flex justify-content-between">
            <a href="/affiliates/{{affiliate.id}}" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Actualizar afiliado</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>