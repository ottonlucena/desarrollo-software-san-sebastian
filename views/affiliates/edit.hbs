<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h3 mb-3">Editar afiliado</h1>

        <p class="text-muted">
          Actualiza los datos del paciente afiliado.
        </p>

        <form action="/affiliates/{{affiliate.id}}/edit" method="POST">
          <div class="mb-3">
            <label for="firstName" class="form-label">Nombre</label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              class="form-control"
              value="{{affiliate.firstName}}"
              required
            >
          </div>

          <div class="mb-3">
            <label for="lastName" class="form-label">Apellido</label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              class="form-control"
              value="{{affiliate.lastName}}"
              required
            >
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control"
              value="{{affiliate.email}}"
              required
            >
          </div>

          <div class="mb-4">
            <label for="membershipType" class="form-label">Tipo de afiliación</label>
            <select id="membershipType" name="membershipType" class="form-select" required>
              <option value="silver">Silver - 5%</option>
              <option value="gold">Gold - 10%</option>
              <option value="platinum">Platinum - 20%</option>
            </select>

            <small class="text-muted">
              Afiliación actual: {{affiliate.membershipType}}
            </small>
          </div>

          <div class="d-flex justify-content-between">
            <a href="/affiliates/{{affiliate.id}}" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Actualizar afiliado</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
