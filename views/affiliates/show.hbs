<div class="row">
  <div class="col-lg-6">
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h1 class="h3 mb-3">Detalle del afiliado</h1>

        <p><strong>ID:</strong> {{affiliate.id}}</p>
        <p><strong>Nombre:</strong> {{affiliate.firstName}} {{affiliate.lastName}}</p>
        <p><strong>Email:</strong> {{affiliate.email}}</p>
        <p>
          <strong>Afiliación:</strong>
          <span class="badge text-bg-secondary text-capitalize">
            {{affiliate.membershipType}}
          </span>
        </p>

        <div class="mt-4">
          <a href="/affiliates" class="btn btn-outline-secondary">Volver</a>
          <a href="/affiliates/{{affiliate.id}}/edit" class="btn btn-outline-warning">Editar</a>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <h2 class="h4 mb-3">Simulador de descuento</h2>

        <p class="text-muted">
          Ingresa el valor del tratamiento para calcular el precio final según la afiliación del paciente.
        </p>

        <form action="/affiliates/{{affiliate.id}}/simulate" method="POST">
          <div class="mb-3">
            <label for="treatmentAmount" class="form-label">Monto del tratamiento</label>
            <input
              type="number"
              id="treatmentAmount"
              name="treatmentAmount"
              class="form-control"
              min="1"
              step="1"
              placeholder="Ej: 80000"
              required
            >
          </div>

          <button type="submit" class="btn btn-primary">
            Calcular precio final
          </button>
        </form>

{{#if simulation}}
  <div class="alert alert-success mt-4">
    <p class="mb-1">
      <strong>Monto original:</strong>
      ${{simulation.treatmentAmount}}
    </p>

    <p class="mb-1">
      <strong>Descuento aplicado:</strong>
      {{simulation.discountPercent}}%
    </p>

    <p class="mb-1">
      <strong>Monto descontado:</strong>
      ${{simulation.discountAmount}}
    </p>

    <p class="mb-0">
      <strong>Precio final:</strong>
      ${{simulation.finalPrice}}
    </p>
  </div>
{{/if}}
      </div>
    </div>
  </div>
</div>
